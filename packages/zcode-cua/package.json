    },
    "./permissions": {
      "types": "./permissions.d.ts",
      "import": "./permissions.js"
    },
    "./driver-host": {
      "types": "./driver-host.d.ts",
      "import": "./driver-host.js"
    },
    "./macos-permissions": {
      "types": "./macos-permissions.d.ts",
      "import": "./macos-permissions.js"
    },
    "./helper-transport": {
      "types": "./helper-transport.d.ts",
